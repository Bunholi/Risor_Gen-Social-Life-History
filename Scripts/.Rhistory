pkgs <- c("tidyverse","ggrepel","ape","vegan","lme4","lmerTest","SNPRelate","ggtree",
"sandwich","pheatmap","janitor","rsample","broom","performance","car","splines",
"AICcmodavg","spdep","broom.mixed","ggeffects","glmmTMB","vcfR","hierfstat",
"ggdist","adegenet","pcadapt", "radiator")
invisible(lapply(pkgs, require, character.only = TRUE))
remotes::install_github("thierrygosselin/radiator")
social.all <- read.csv(file.path(data_dir, "social_data_all_complete.csv"))
# Install required packages before the first run.
# Uncomment this command only if the packages are not already installed.
# install.packages(c(
